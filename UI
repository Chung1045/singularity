import React, { useEffect, useRef } from 'react';
import './globals.css';
import './styleguide.css';
import './style.css';

const Singularity = () => {
  const rootRef = useRef(null);
  const triggerRef = useRef(null);

  useEffect(() => {
    const saved = localStorage.getItem('sidebar-collapsed') === 'true';
    if (saved) {
      rootRef.current.classList.add('collapsed');
      triggerRef.current.setAttribute('aria-expanded', 'true');
    }
  }, []);

  const handleToggle = () => {
    const collapsed = rootRef.current.classList.toggle('collapsed');
    triggerRef.current.setAttribute('aria-expanded', collapsed ? 'true' : 'false');
    localStorage.setItem('sidebar-collapsed', collapsed);
  };

  return (
    <div className="sidebar-expand" ref={rootRef} data-model-id="2004:2885">
      <div className="group">
        <main className="right-container">
          <section className="main-screen">
            <header className="main-screen-title">
              <img
                className="bouncy-logo"
                src="https://c.animaapp.com/W03AeLaz/img/bouncy-logo-animation.svg"
                alt="Singularity Logo"
              />
              <div className="logo-text">
                <h1 className="text-wrapper">Singularity</h1>
              </div>
            </header>
            <form className="input-field" role="search" aria-label="Main search">
              <button type="button" className="input-field-button" aria-label="Add new item">
                <img className="vector" src="https://c.animaapp.com/W03AeLaz/img/vector-2.svg" alt="" />
              </button>
              <label htmlFor="main-search-input" className="visually-hidden">Search</label>
              <input
                type="text"
                id="main-search-input"
                className="div"
                placeholder="What's on your mind?"
                aria-label="What's on your mind?"
              />
              <button type="submit" className="input-field-button" aria-label="Submit search">
                <img className="img" src="https://c.animaapp.com/W03AeLaz/img/vector-3.svg" alt="" />
              </button>
            </form>
          </section>
        </main>
        <aside className="side-bar" aria-label="Sidebar navigation">
          <nav>
            <button
              className="history"
              type="button"
              aria-expanded="false"
              aria-controls="history-submenu"
              onClick={handleToggle}
              ref={triggerRef}
            >
              <img className="slash-circle" src="https://c.animaapp.com/W03AeLaz/img/slash-circle-1.svg" alt="" />
              <span className="text-wrapper-2">History</span>
              <span className="submenu" aria-hidden="true"><span className="text-wrapper-3">􀆊</span></span>
            </button>
            <form className="search-file-field" role="search" aria-label="Search files">
              <img className="search" src="https://c.animaapp.com/W03AeLaz/img/search-1.svg" alt="" />
              <label htmlFor="search-files-input" className="visually-hidden">Search files</label>
              <input
                type="search"
                id="search-files-input"
                className="text-wrapper-4"
                placeholder="Search files"
                aria-label="Search files"
              />
            </form>
            <img className="union" src="https://c.animaapp.com/W03AeLaz/img/union.svg" alt="Singularity Icon" />
            <button className="trigger" type="button" aria-label="Close sidebar" aria-expanded="false">
              <span className="close-side-bar"><span className="text-wrapper-5">􀆊</span></span>
            </button>
            <div className="horizontal-inset" role="separator">
              <img className="divider" src="https://c.animaapp.com/W03AeLaz/img/divider-1.svg" alt="" />
            </div>
            <a href="#" className="sign-up-link">
              <img className="user" src="https://c.animaapp.com/W03AeLaz/img/user.svg" alt="" />
              <span className="text-wrapper-6">Sign Up</span>
            </a>
          </nav>
        </aside>
      </div>
    </div>
  );
};

export default Singularity;
