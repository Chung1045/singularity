<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Cache Control -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <!-- Socket.io Client -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Markdown and Icons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.2/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.9/dist/purify.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <!-- Load z-index helper -->
    <script src="/scripts/zIndexHelper.js"></script>
    <!-- Load shared utilities first -->
    <script src="/scripts/projectUtils.js"></script>
    <!-- Load Notification Panel component -->
    <script src="/components/NotificationPanel.js"></script>
    <!-- Load Sidebar component -->
    <script src="/components/Sidebar.js"></script>
    <link rel="stylesheet" href="/components/sidebar.css">
    <!-- Load Right Sidebar component -->
    <script src="/components/RightSidebar.js"></script>
    <link rel="stylesheet" href="/components/rightSidebar.css">
    <!-- Load Requirements Panel component -->
    <script src="/components/requirementsPanel.js"></script>
    <link rel="stylesheet" href="/stylesheets/requirementsPanel.css">
    <!-- Load File Upload Notification Modal (simple version) -->
    <script src="/components/fileUploadNotificationModal.js"></script>
    <!-- Load File Upload Component -->
    <script src="/components/fileUploadComponent.js"></script>
    <!-- Load modular components (refactored from tempHome.js) -->
    <script src="/components/HomeComponents/ChatMessage.js"></script>
    <script src="/components/HomeComponents/homeModals.js"></script>
    <script src="/components/HomeComponents/ChatHistoryItem.js"></script>
    <script src="/components/HomeServices/ChatUtils.js"></script>
    <script src="/components/HomeServices/ChatService.js"></script>
    <script src="/components/HomeServices/EditMode.js"></script>
    <script src="/components/HomeServices/ReportService.js"></script>
    <script src="/components/HomeServices/FileChipsManager.js"></script>
    <script src="/components/HomeServices/ChatController.js"></script>

    <!-- Load Add Invite Component -->
    <script src="/components/addInviteComponent.js"></script>
    <script src="/components/projectShareComponent.js"></script>
    <!-- Load main TempHome component -->
    <script src="/scripts/tempHome.js"></script>

    <link rel="stylesheet" href="/stylesheets/z-index.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
    <link rel="stylesheet" href="/stylesheets/chat.css">
</head>
<body>

<div id="root">Loading...</div>

<script>
    const userInfo  = <%- JSON.stringify(userInfo || {}) %>;
    const csrfToken = "<%= csrfToken %>";
    
    // Make userInfo globally available for socket initialization
    window.userInfo = userInfo;

    console.log("tempHome.ejs → userInfo received:", userInfo);
    console.log("window.Sidebar available?", typeof window.Sidebar);
    console.log("window.RightSidebar available?", typeof window.RightSidebar);
    console.log("window.TempHome available?", typeof window.TempHome);
    console.log("window.FileUploadComponent available?", typeof window.FileUploadComponent);

    try {
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(React.createElement(window.TempHome, { userInfo, csrfToken }));

        // Sidebar component now handles project data initialization automatically
        console.log('TempHome component rendered. Sidebar will load project data.');
    } catch (error) {
        console.error("Error rendering TempHome:", error);
        document.getElementById('root').innerHTML = '<div style="padding: 20px; color: red;">Error: ' + error.message + '</div>';
    }
</script>

<!-- Socket.io initialization for real-time notifications - load AFTER userInfo is set -->
<script src="/scripts/socketInit.js"></script>

</body>
</html>

