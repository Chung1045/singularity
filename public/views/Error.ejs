<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/stylesheets/error.css"/>
    <title>Error</title>
</head>
<body>

<header class="container">
    <div class="error-container">
        <div class="error-code">
            <%= statusCode %>
        </div>
        <p class="error-message"><%= errorMessage %></p>
    </div>

    <div class="logo-container">
        <img class="bouncy-logo" src="./img/bouncy-logo-animation.svg" alt="Singularity Logo">
        <div class="logo-text">
            <h1 class="text-wrapper">Singularity</h1>
        </div>
    </div>
    <div class="content-container">
        <p>Encountered an issue? View system status or contact support.</p>
        <button id="supportBtn">Support & Status</button>
    </div>
</header>

<script>
    document.getElementById("supportBtn")
        .addEventListener("click", () => {
            window.location.href = "/support";
        });
</script>

</body>
</html>
