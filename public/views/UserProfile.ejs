<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Cache Control -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>User Profile</title>
    <script src="/scripts/consoleWarning.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- <link rel="stylesheet" href="/stylesheets/test/profile.css"> -->
     <link rel="stylesheet" href="/stylesheets/profile.css">
     <link rel="stylesheet" href="/stylesheets/z-index.css">
     <link rel="stylesheet" href="/stylesheets/skeleton.css">

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <!-- Socket.io Client -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- Load z-index helper -->
    <script src="/scripts/zIndexHelper.js"></script>
    <!-- Load shared utilities first -->
    <script src="/scripts/projectUtils.js"></script>
    <!-- Load Notification Panel component -->
    <script src="/components/NotificationPanel.js"></script>
    <!-- Load Sidebar component -->
    <script src="/components/Sidebar.js"></script>
    <link rel="stylesheet" href="/components/sidebar.css">
    <!-- Load Search Results component -->
    <script src="/components/sidebarInnerSearchResults.js"></script>
    <!-- Load Search Panel component -->
    <script src="/components/SearchPanel.js"></script>
    <!-- Load File Upload Notification Modal (simple version) -->
    <script src="/components/fileUploadNotificationModal.js"></script>
    <!-- Load File Upload Component -->
    <script src="/components/fileUploadComponent.js"></script>
    <script src="/components/requirementsPanel.js"></script>
    <link rel="stylesheet" href="/stylesheets/requirementsPanel.css">
    <!-- Load Project Share Components -->
    <script src="/components/addInviteComponent.js"></script>
    <script src="/components/projectShareComponent.js"></script>
</head>
<body>

<div id="root">
    <div class="sk-page">
        <div class="sk-sidebar">
            <div class="sk-box sk-sidebar-logo"></div>
            <div class="sk-box sk-sidebar-row"></div>
            <div class="sk-box sk-sidebar-row medium"></div>
            <div class="sk-box sk-sidebar-row short"></div>
            <div class="sk-box sk-sidebar-row"></div>
            <div class="sk-box sk-sidebar-row medium"></div>
        </div>
        <div class="sk-main">
            <div class="sk-box sk-title"></div>
            <div class="sk-card">
                <div class="sk-row">
                    <div class="sk-box sk-avatar" style="width:88px;height:88px;"></div>
                    <div style="flex:1;display:flex;flex-direction:column;gap:12px;">
                        <div class="sk-box sk-line w-1-3"></div>
                        <div class="sk-box sk-line w-1-4"></div>
                    </div>
                </div>
            </div>
            <div class="sk-card">
                <div class="sk-box sk-line w-1-4"></div>
                <div class="sk-table-row"><div class="sk-box sk-line w-1-4"></div><div class="sk-box sk-line w-1-2"></div></div>
                <div class="sk-table-row"><div class="sk-box sk-line w-1-4"></div><div class="sk-box sk-line w-1-3"></div></div>
                <div class="sk-table-row"><div class="sk-box sk-line w-1-4"></div><div class="sk-box sk-line w-1-2"></div></div>
                <div class="sk-table-row"><div class="sk-box sk-line w-1-4"></div><div class="sk-box sk-line w-1-3"></div></div>
            </div>
        </div>
    </div>
</div>

<!-- Load your component -->
<script src="/scripts/UserProfile.js"></script>

<!-- Render the component -->
<script>
    console.log('React:', typeof React);
    console.log('ReactDOM:', typeof ReactDOM);
    console.log('FileUploadComponent available:', typeof window.FileUploadComponent);

    console.log("window.Sidebar available?", typeof window.Sidebar);
    console.log("window.FileUploadComponent available?", typeof window.FileUploadComponent);



    const userInfo = <%- JSON.stringify(userInfo || []) %>;
    const csrfToken = "<%= csrfToken %>";

    // Make userInfo globally available for socket initialization
    window.userInfo = userInfo;

    // Add file upload event listener (same as tempHome)
    const handleOpenFileUpload = (event) => {
        const { projectID } = event.detail;
        console.log('[FileUpload] Opening file upload modal for project:', projectID);
        if (window.FileUploadComponent) {
            const modalContainer = document.createElement('div');
            modalContainer.id = 'file-upload-modal-container';
            modalContainer.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: rgba(0, 0, 0, 0.5);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: ${window.ZIndex?.MODAL || 31};
                padding: 20px;
            `;
            modalContainer.onclick = (e) => {
                if (e.target === modalContainer) {
                    document.body.removeChild(modalContainer);
                }
            };
            document.body.appendChild(modalContainer);

            const modalRoot = ReactDOM.createRoot(modalContainer);
            // Store projectID for use in callback
            const currentProjectID = projectID;
            modalRoot.render(
                React.createElement(window.FileUploadComponent, {
                    projectID: currentProjectID,
                    onClose: () => {
                        modalRoot.unmount();
                        if (document.body.contains(modalContainer)) {
                            document.body.removeChild(modalContainer);
                        }
                    },
                    onFilesUploaded: (files) => {
                        console.log('Files uploaded:', files);
                        console.log('Refreshing files for project:', currentProjectID);
                        // Refresh the source list in sidebar
                        if (typeof window.fetchProjectFiles === 'function') {
                            window.fetchProjectFiles(currentProjectID);
                        } else {
                            console.error('fetchProjectFiles not available');
                        }
                    }
                })
            );
        }
    };

    window.addEventListener('openFileUpload', handleOpenFileUpload);

    try {
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(React.createElement(window.UserProfile, {userInfo, csrfToken}));
        console.log('React component rendered successfully');
    } catch (error) {
        console.error('Error rendering React component:', error);
        document.getElementById('root').innerHTML = '<div style="color: red; padding: 20px;">Error: ' + error.message + '</div>';
    }
</script>

<!-- Socket.io initialization for real-time notifications - load AFTER userInfo is set -->
<script src="/scripts/socketInit.js"></script>

</body>
</html>
