<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Singularity</title>
    <script src="/scripts/consoleWarning.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/landing.css">
</head>
<body>

    <!-- Slide-up notification (same style as login/signup) -->
    <div id="message" class="hidden">
        <span class="alert-icon"><img src="/img/Info.svg" alt="alert"></span>
        <span class="alert-text" id="message-text"></span>
        <span id="message-close-btn"><img src="/img/close.svg" alt="close"></span>
    </div>

    <!-- Navbar -->
    <nav id="ld-nav">
        <a href="/" id="ld-nav-logo">
            <img src="/img/union.svg" alt="Singularity" id="ld-nav-logo-icon">
            <span id="ld-nav-logo-text">Singularity</span>
        </a>
        <div id="ld-nav-actions">
            <a href="/signup" id="ld-btn-signup" class="ld-nav-btn ld-nav-btn--fill">Sign Up</a>
            <a href="/login"  id="ld-btn-signin" class="ld-nav-btn ld-nav-btn--fill">Sign in</a>
        </div>
    </nav>

    <!-- Hero -->
    <main id="ld-hero">

        <!-- Left: image slideshow -->
        <div id="ld-hero-image-panel">
            <div class="ld-slide active" style="background-image:url('/img/LDPic_1.png')"></div>
        </div>

        <!-- Right: text -->
        <div id="ld-hero-text-panel">
            <div id="ld-hero-text-inner">
                <h1 id="ld-hero-headline">
                    For the new era of better software requirements.
                </h1>
                <h2 id="ld-hero-sub">
                    Here. Comes. <em>A new</em> <span id="ld-accent">PLAYER</span>.
                </h2>
                <p id="ld-hero-tagline">And with ai, it will be much easier.</p>
            </div>
        </div>

    </main>

   

    <script>
        // Slideshow
        (function () {
            const slides = document.querySelectorAll('.ld-slide');
            let current = 0;
            setInterval(function () {
                slides[current].classList.remove('active');
                current = (current + 1) % slides.length;
                slides[current].classList.add('active');
            }, 4000);
        })();
    </script>

    <script>
        (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.get('loggedout') === '1') {
                const msg     = document.getElementById('message');
                const msgText = document.getElementById('message-text');
                msgText.textContent = 'You have been logged out successfully.';
                msg.classList.remove('hidden');
                // clean URL
                window.history.replaceState({}, '', '/');
                // close button
                document.getElementById('message-close-btn').addEventListener('click', function () {
                    msg.classList.add('hidden');
                });
                // auto hide after 4s
                setTimeout(function () { msg.classList.add('hidden'); }, 4000);
            }
        })();
    </script>

</body>
</html>
