<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Profile Pic upload</title>
</head>
<body>


<div id="div-testSelf">
    <h1>Test Profile Pic</h1>
    <img id="profile-pic" alt="Profile Picture" style="max-width: 200px; display: block; margin-bottom: 10px;">

    <button id="btn-change" onclick="changeProfilePic()">
        Change Profile Picture
    </button>

    <button id="btn-remove" onclick="removeProfilePic()">
        Remove Profile Picture
    </button>
</div>

<div id="div-testUsers">
    <h1>Test Other User Profile Pic</h1>
    <div id="test-container">

    </div>
    <div id="test-projectContainer">
        <select id="projectDropdown" onchange="fetchProjectFiles(this.value)">
        </select>
        <div id="div-testDocuments">

        </div>
    </div>
</div>

</body>

<script>

    window.onload = async function() {
        await fetchProfilePics()
        await testFetchOtherUser()
        await fetchProjects()
    };

    async function fetchProfilePics(){
        let response = await fetch('/api/profile-pic/fetch', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({})
        });

        let profileImgData = await response.json();

        console.log('Full response:', profileImgData); // Debug: see the structure

        if (profileImgData.success) {
            console.log('Data:', profileImgData.data); // Debug: see what data looks like

            // Since fetchProfilePics returns an array, get the first item
            const imageData = profileImgData.data[0]?.image; // Access first user's image

            if (imageData) {
                document.getElementById('profile-pic').src = imageData;
            } else {
                // Set a default/placeholder image
                document.getElementById('profile-pic').src = '';
            }
        }
    }

    async function changeProfilePic() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';

        input.onchange = async (e) => {
            const file = e.target.files[0];
            if (file) {
                console.log('Selected file:', file);

                // Upload to server using FormData
                const formData = new FormData();
                formData.append('file', file); // Must be 'file' to match upload.single('file')

                try {
                    const response = await fetch('/api/profile-pic/replace', {
                        method: 'POST',
                        body: formData // Don't set Content-Type header
                    });

                    const result = await response.json();
                    if (response.ok) {
                        console.log('Upload successful!');
                        await fetchProfilePics()
                    } else {
                        console.error('Upload failed:', result.message);
                    }
                } catch (error) {
                    console.error('Error uploading:', error);
                }
            }
        };

        input.click();
    }

    async function removeProfilePic() {
        try {
            const response = await fetch('/api/profile-pic/remove', {
                method: 'POST',
            });

            const result = await response.json();
            if (result.success) {
                console.log("Remove successful");
                document.getElementById('profile-pic').src = '';
            } else {
                console.error('Remove Failed:', result.message);
            }
        } catch (error) {
            console.error('Error removing profile pic:', error);
        }
    }

    async function testFetchOtherUser() {
        let userIDs = ["a84d6226-d94c-423e-b530-07d0b5b9163b", "77a77387-b5f3-4c4c-9d8d-ed917b816bd1", "c9a0efe9-f801-46b5-a373-1a80277ae89c", "53e19356-ea50-44b1-b23b-d10f23053a24"];

        try {
            const response = await fetch('/api/profile-pic/fetch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    userIDs: userIDs
                })
            });

            const result = await response.json();
            if (result.success) {
                console.log('Fetch successful!');
                console.log('Result data:', result.data);

                const testContainer = document.querySelector("div#test-container");

                for (const data of result.data) {
                    const userEntryTitle = document.createElement('p');
                    userEntryTitle.innerHTML = `${data.userID}`;
                    testContainer.append(userEntryTitle);

                    const userProfilePic = document.createElement("img");

                    if (data.image) {
                        userProfilePic.src = data.image;
                    } else {
                        userProfilePic.src = ''; // Fallback for no image
                    }

                    userProfilePic.alt = `Profile pic for ${data.userID}`;
                    userProfilePic.style.maxWidth = '100px'; // Optional: set size
                    testContainer.append(userProfilePic);
                }
            } else {
                console.error('Fetch failed:', result.message);
            }
        } catch (error) {
            console.error('Error fetching:', error);
        }
    }

    async function fetchProjects() {
        const response = await fetch('/api/project/list', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({})
        });

        if (response.ok) {
            let data = await response.json()
            console.log(`Project Data: ${JSON.stringify(data)}`)
            populateProjectDropdown(data.projects)
            let defaultProjectID = data.projects[0]?.projectID;

            if (defaultProjectID) {
                await fetchProjectFiles(defaultProjectID)
            }
        }
    }

    function populateProjectDropdown(projects) {
        const dropdown = document.getElementById('projectDropdown');

        const options = projects.map((project, index) =>
            `<option value="${project.projectID}" ${index === 0 ? 'selected' : ''}>${project.projectName}</option>`
        ).join('');

        dropdown.innerHTML = options;

        if (projects.length > 0) {
            dropdown.dispatchEvent(new Event('change'));
        }
    }

    async function fetchProjectFiles(projectID) {
        console.log(`Fetching ${projectID} files`)
        const response = await fetch('/api/project/file/list', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                projectID: projectID
            })
        });

        if (response.ok) {
            let data = await response.json()
            console.log(`Response Data: ${JSON.stringify(data)}`)
            const testContainer = document.querySelector("div#div-testDocuments");
            for (file of data.files) {
                const documentEntry = document.createElement('p');
                documentEntry.innerHTML = `${file.documentName}.${file.documentExt}`
                testContainer.append(documentEntry);
            }
        }

    }

</script>
</html>
