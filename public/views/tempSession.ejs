<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Temp Passkeys</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <link rel="stylesheet" href="/components/sidebar.css">
    <!-- <link rel="stylesheet" href="/stylesheets/test/session.css"> -->
    <link rel="stylesheet" href="/stylesheets/session.css">
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>

</head>
<body>
<div id="root"></div>

<script src="/components/Sidebar.js"></script>
<script src="/scripts/tempSessions.js"></script>

<script>
    const csrfToken = "<%= csrfToken %>";
    const sessions = <%- JSON.stringify(sessions || []) %>;
    const loginAttempts = <%- JSON.stringify(loginAttempts || []) %>;
    const userInfo  = <%- JSON.stringify(userInfo || {}) %>;

    console.log("tempSession.ejs → userInfo received:", userInfo);


    console.log("CSRF:", csrfToken);

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(React.createElement(window.TempSession, { csrfToken, sessions, loginAttempts, userInfo }));
</script>
</body>
</html>
