<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSE Chat Stream Tester</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f5f5f5;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .header {
            background: #2563eb;
            color: white;
            padding: 20px;
        }

        h1 {
            font-size: 24px;
            font-weight: 600;
        }

        .config {
            padding: 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .config label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #374151;
        }

        .config input {
            width: 100%;
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
        }

        .chat-container {
            height: 400px;
            overflow-y: auto;
            padding: 20px;
            background: #f9fafb;
        }

        .message {
            margin-bottom: 16px;
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message-label {
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .message-content {
            padding: 12px 16px;
            border-radius: 8px;
            background: white;
            border: 1px solid #e5e7eb;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .user .message-content {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .assistant .message-content {
            background: white;
        }

        .error .message-content {
            background: #fef2f2;
            border-color: #fecaca;
            color: #991b1b;
        }

        .streaming {
            position: relative;
        }

        .streaming::after {
            content: '▋';
            animation: blink 1s infinite;
            margin-left: 2px;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .input-area {
            padding: 20px;
            border-top: 1px solid #e5e7eb;
            background: white;
        }

        .input-group {
            display: flex;
            gap: 10px;
        }

        textarea {
            flex: 1;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
            font-family: inherit;
            resize: none;
            min-height: 60px;
        }

        textarea:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        button {
            padding: 12px 24px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        button:hover:not(:disabled) {
            background: #1d4ed8;
        }

        button:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

        .status {
            padding: 8px 16px;
            margin: 10px 20px;
            border-radius: 6px;
            font-size: 13px;
            text-align: center;
        }

        .status.connected {
            background: #d1fae5;
            color: #065f46;
        }

        .status.streaming {
            background: #dbeafe;
            color: #1e40af;
        }

        .status.error {
            background: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>SSE Chat Stream Tester</h1>
    </div>

    <div class="config">
        <label for="endpoint">Endpoint URL:</label>
        <input type="text" id="endpoint" value="http://localhost:9090/api/agent/chat/stream" placeholder="Enter your API endpoint">
    </div>

    <div id="status"></div>

    <div class="chat-container" id="chatContainer"></div>

    <div class="input-area">
        <div class="input-group">
            <textarea id="messageInput" placeholder="Type your message here..." rows="2"></textarea>
            <button id="sendBtn" onclick="sendMessage()">Send</button>
        </div>
    </div>
</div>

<script>
    let isStreaming = false;
    let currentMessageEl = null;

    function showStatus(message, type) {
        const statusEl = document.getElementById('status');
        statusEl.textContent = message;
        statusEl.className = `status ${type}`;

        if (type === 'connected') {
            setTimeout(() => {
                statusEl.textContent = '';
                statusEl.className = 'status';
            }, 3000);
        }
    }

    function addMessage(role, content, isComplete = true) {
        const chatContainer = document.getElementById('chatContainer');

        if (role === 'user') {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message user';
            messageDiv.innerHTML = `
                    <div class="message-label">You</div>
                    <div class="message-content">${escapeHtml(content)}</div>
                `;
            chatContainer.appendChild(messageDiv);
            currentMessageEl = null;
        } else if (role === 'assistant') {
            if (!currentMessageEl) {
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message assistant';
                messageDiv.innerHTML = `
                        <div class="message-label">Assistant</div>
                        <div class="message-content streaming"></div>
                    `;
                chatContainer.appendChild(messageDiv);
                currentMessageEl = messageDiv.querySelector('.message-content');
            }

            currentMessageEl.textContent = content;

            if (isComplete) {
                currentMessageEl.classList.remove('streaming');
                currentMessageEl = null;
            }
        } else if (role === 'error') {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message error';
            messageDiv.innerHTML = `
                    <div class="message-label">Error</div>
                    <div class="message-content">${escapeHtml(content)}</div>
                `;
            chatContainer.appendChild(messageDiv);
            currentMessageEl = null;
        }

        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function sendMessage() {
        const input = document.getElementById('messageInput');
        const message = input.value.trim();
        const endpoint = document.getElementById('endpoint').value.trim();

        if (!message || isStreaming) return;

        if (!endpoint) {
            showStatus('Please enter an endpoint URL', 'error');
            return;
        }

        const sendBtn = document.getElementById('sendBtn');
        sendBtn.disabled = true;
        isStreaming = true;

        addMessage('user', message);
        input.value = '';

        showStatus('Streaming response...', 'streaming');

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ message: message })
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let fullResponse = '';

            while (true) {
                const { done, value } = await reader.read();

                if (done) break;

                const chunk = decoder.decode(value, { stream: true });
                const lines = chunk.split('\n');

                for (const line of lines) {
                    if (line.startsWith('data: ')) {
                        const data = line.slice(6);

                        if (data === '[DONE]') {
                            addMessage('assistant', fullResponse, true);
                            showStatus('Stream complete', 'connected');
                        } else if (data.startsWith('{')) {
                            try {
                                const parsed = JSON.parse(data);
                                if (parsed.error) {
                                    throw new Error(parsed.error);
                                }
                            } catch (e) {
                                // Not JSON, treat as text
                                fullResponse += data;
                                addMessage('assistant', fullResponse, false);
                            }
                        } else {
                            fullResponse += data;
                            addMessage('assistant', fullResponse, false);
                        }
                    }
                }
            }
        } catch (error) {
            console.error('Error:', error);
            addMessage('error', `Failed to stream: ${error.message}`);
            showStatus('Stream failed', 'error');
        } finally {
            isStreaming = false;
            sendBtn.disabled = false;
            input.focus();
        }
    }

    document.getElementById('messageInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    document.getElementById('messageInput').focus();
</script>
</body>
</html>
