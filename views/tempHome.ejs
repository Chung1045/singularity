<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Temp Login</title>
</head>
<body>
<div style="display: flex; flex-direction: column; gap: 10px;">

    <h2>Home</h2>
    <h3>You have logged in</h3>
    <input type="hidden" name="_csrf" id="hidden-csrf" value="<%= csrfToken %>">
    <button id="btn-passkeyRegister" onclick="testPasskeyOption()">Register Passkey</button>
    <button id="btn-logout">Logout</button>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.js"
        integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4="
        crossorigin="anonymous"></script>
<script src="/scripts/tempHome.js"></script>

<!-- Add SimpleWebAuthn from CDN -->
<script type="module">
    import {
        startRegistration,
        startAuthentication,
        browserSupportsWebAuthn
    } from 'https://unpkg.com/@simplewebauthn/browser@10.0.0/dist/bundle/index.js';

    const isSupported = browserSupportsWebAuthn();
    console.log('Passkey supported:', isSupported);

    window.testPasskeyOption = async () => {
        const csrfToken = $("#hidden-csrf").val();
        const resp = await fetch('/api/passkey/gen-option', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': csrfToken
            },
            body: JSON.stringify({}),
        });

        const options = await resp.json();
        console.log("Passkey options:", options);

        try {
            const attResp = await startRegistration(options)
            alert("AttRep Response:" + JSON.stringify({ attResp }))

            const result = await fetch('/api/passkey/verify-register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': csrfToken
                },
                body: JSON.stringify({attResp})
            })

            alert("Registration result:" + JSON.stringify(result))

        } catch (e) {
            alert("Error occured:" + e)
        }

    }

    // Make functions globally accessible if needed
    window.register = async function(username) {
        const csrfToken = $("#hidden-csrf").val();
        const resp = await fetch('/generate-registration-options', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
            body: JSON.stringify({ username }),
        });

        const options = await resp.json();
        const attResp = await startRegistration(options);

        const verificationResp = await fetch('/verify-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, attResp }),
        });

        console.log(await verificationResp.json());
    }

    window.login = async function(username) {
        const resp = await fetch('/generate-authentication-options', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username }),
        });

        const options = await resp.json();
        const authResp = await startAuthentication(options);

        const verificationResp = await fetch('/verify-authentication', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, authResp }),
        });

        console.log(await verificationResp.json());
    }
</script>

</body>
</html>
