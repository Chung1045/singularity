<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Temp Login</title>
</head>
<script
        src="https://code.jquery.com/jquery-3.7.1.js"
        integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4="
        crossorigin="anonymous"></script>
<script src="/scripts/tempLogin.js"></script>
<body>
<div style="display: flex; flex-direction: column; gap: 10px;">

    <input type="hidden" name="_csrf" id="hidden-csrf" value="<%= csrfToken %>">

    <div>
        <label for="input-usernameEmail">Username or email address</label><br>
        <input type="text" id="input-usernameEmail">
    </div>
    <div>
        <label for="input-password">Password</label><br>
        <input type="password" id="input-password">
    </div>

    <button id="btn-login">Login</button>
    <hr>

    <button id="btn-googleOAuth">Continue with Google</button>
    <button id="btn-signup">Signup</button>
    <button id="btn-passkeyLogin">Login with Passkey</button>

    <script type="module">
        import { startAuthentication } from 'https://unpkg.com/@simplewebauthn/browser@10.0.0/dist/bundle/index.js';

        $("#btn-passkeyLogin").on("click", async () => {
            const csrfToken = $("#hidden-csrf").val();
            const resp = await fetch('/api/passkey/gen-auth-option', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': csrfToken
                },
                body: JSON.stringify({}),
            });

            const response = await resp.json()
            const credential = await startAuthentication(response)

            const verifyResp = await fetch('/api/passkey/verify-authentication', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': csrfToken
                },
                body: JSON.stringify({ credential }),
            });

        })
    </script>

</div>
</body>
</html>
