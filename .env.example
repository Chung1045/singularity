# ========================================
# DEVELOPMENT OPTIONS
# ========================================
 ENABLE_HTTPS=boolean

 # This option disables csrf checking, DO NOT ENABLE IN PRODUCTION
 ENABLE_USER_CHECKING=boolean

 NODE_ENV=production / development
 USE_NGINX_SSL=boolean

# ========================================
# SERVER CONFIG - SERVER / HTTPS
# ========================================
 EXPECTED_ORIGIN_DOMAIN=domain
 SSL_CERT_PATH=path
 SSL_KEY_PATH=path
 USER_SUPPORT_URL=url
 ENFORCE_TRANSCRIPT_TIME_LIMIT=boolean
 ENFORCE_TRANSCRIPT_TIME_MAX=integer (minutes)

# ========================================
# SERVER CONFIG - FILE SERVER
# ========================================
 MINIO_ACCESSKEY=text
 MINIO_BUCKET=text
 MINIO_END_POINT=domain
 MINIO_PORT=integer (port)
 MINIO_SECRETKEY=text

# ========================================
# SERVER CONFIG - OAUTH AUTHENTICATION
# ========================================
 GOOGLE_CLIENT_ID=text
 GOOGLE_CLIENT_SECRET=text

# ========================================
# SERVER CONFIG - API SERVICES
# ========================================
 HUGGING_FACE_TOKEN=text
 XAI_API_KEY=text
